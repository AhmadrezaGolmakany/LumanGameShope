@page "/"

@using LumanGameShope.Web.DTOs.Product

<PageTitle>محصولات — Luman Game Shop</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="px-4 py-6">

    @* ---------- سربرگ صفحه ---------- *@
    <MudStack Row="false" Spacing="1" Class="mb-6">
        <MudText Typo="Typo.overline" Style="color:var(--luman-gold); letter-spacing:.06em;">
            فروشگاه
        </MudText>
        <MudText Typo="Typo.h4" Style="font-weight:800;">همه محصولات</MudText>
        <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">
            کد بازی، اشتراک و لوازم جانبی — با تحویل آنی
        </MudText>
    </MudStack>

    @* ---------- نوار جستجو و فیلتر دسته‌بندی ---------- *@
    <MudStack Row="true" Spacing="3" Class="mb-4" Style="flex-wrap:wrap;">
        <MudTextField T="string" @bind-Value="_searchTerm"
                      Placeholder="جستجوی بازی، کنسول، لوازم جانبی…"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" Margin="Margin.Dense"
                      Style="max-width:340px;" />

        <MudSpacer />

        <MudChipSet T="string" SelectedValuesChanged="OnCategoryChanged" SelectedValues="new[] { _activeCategory }"
                    Filter="true" Mandatory="true">
            @foreach (var cat in _categories)
            {
                <MudChip Text="@cat" Value="@cat" Color="Color.Warning" Variant="Variant.Outlined" />
            }
        </MudChipSet>
    </MudStack>

    @* ---------- حالت بارگذاری ---------- *@
    @if (_isLoading)
    {
        <MudGrid Spacing="4">
            @for (int i = 0; i < 8; i++)
            {
                <MudItem xs="6" sm="4" md="3">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="320px" Style="border-radius:12px;" />
                </MudItem>
            }
        </MudGrid>
    }
    @* ---------- حالت خالی ---------- *@
    else if (!_filteredProducts.Any())
    {
        <MudPaper Class="pa-8 d-flex flex-column align-center" Elevation="0"
                  Style="border:1px dashed var(--mud-palette-lines-default); border-radius:12px;">
            <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Size="Size.Large" Style="color:var(--mud-palette-text-disabled);" />
            <MudText Typo="Typo.body1" Class="mt-2">محصولی با این مشخصات پیدا نشد</MudText>
            <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">
                عبارت جستجو یا دسته‌بندی را تغییر دهید
            </MudText>
        </MudPaper>
    }
    @* ---------- گرید محصولات ---------- *@
    else
    {
        <MudGrid Spacing="4">
            @foreach (var product in _filteredProducts)
            {
                <MudItem xs="6" sm="4" md="3">
                    <MudCard Class="luman-product-card" Elevation="0">
                        <div class="luman-card-tag luman-tag-@GetTagColor(product.ProductId)"></div>

                        <MudCardMedia Height="160" Image="@GetImageUrl(product)" Class="luman-card-media">
                            @if (string.IsNullOrEmpty(product.Imagename))
                            {
                                <div class="luman-media-fallback">
                                    <MudIcon Icon="@Icons.Material.Outlined.SportsEsports" Size="Size.Large" />
                                </div>
                            }
                        </MudCardMedia>

                        <MudCardContent Class="pb-1">
                            <MudText Typo="Typo.caption" Style="color:var(--luman-teal); font-weight:600;">
                                @GetCategoryLabel(product.ProductId)
                            </MudText>
                            <MudText Typo="Typo.subtitle2" Class="mt-1" Style="font-weight:600; min-height:2.6em;">
                                @product.Name
                            </MudText>
                        </MudCardContent>

                        <MudCardActions Class="d-flex justify-space-between align-center px-4 pb-4 pt-0">
                            <MudText Class="luman-price">@FormatPrice(product.Price)</MudText>
                            <MudButton Variant="Variant.Filled" Size="Size.Small"
                                       Style="background:var(--luman-gold); color:#3d2a0e; font-weight:600;"
                                       OnClick="() => AddToCart(product)">
                                افزودن
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }

</MudContainer>

<style>
    :root {
        --luman-gold: #e7a33e;
        --luman-teal: #46c2b4;
        --luman-coral: #e2564a;
    }

    .luman-product-card {
        position: relative;
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 12px;
        overflow: hidden;
        transition: border-color .15s ease, transform .15s ease;
    }

        .luman-product-card:hover {
            border-color: var(--luman-gold);
            transform: translateY(-2px);
        }

    .luman-card-tag {
        position: absolute;
        top: 0;
        right: 0;
        width: 0;
        height: 0;
        z-index: 2;
        border-style: solid;
        border-width: 20px 20px 0 0;
    }

    .luman-tag-gold {
        border-color: var(--luman-gold) transparent transparent transparent;
    }

    .luman-tag-teal {
        border-color: var(--luman-teal) transparent transparent transparent;
    }

    .luman-tag-coral {
        border-color: var(--luman-coral) transparent transparent transparent;
    }

    .luman-card-media {
        background: var(--mud-palette-background-grey);
    }

    .luman-media-fallback {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--mud-palette-text-disabled);
    }

    .luman-price {
        font-family: 'JetBrains Mono', monospace;
        font-weight: 700;
        font-size: .95rem;
    }
</style>

@code {
    // ===================== داده تستی (Mock) =====================
    // این لیست فقط برای طراحی UI است — بعداً با HttpClient از GetAllForIndex جایگزین می‌شود
    private List<ProductForIndex> _mockProducts = new()
    {
        new() { ProductId = 1, Name = "Shadow Realm Origins", Price = 349000, Imagename = "" },
        new() { ProductId = 2, Name = "Velocity Circuit 3", Price = 219000, Imagename = "" },
        new() { ProductId = 3, Name = "هدست بی‌سیم Nova X", Price = 980000, Imagename = "" },
        new() { ProductId = 4, Name = "Champions League 26", Price = 275000, Imagename = "" },
        new() { ProductId = 5, Name = "Silent Harbor", Price = 189000, Imagename = "" },
        new() { ProductId = 6, Name = "دسته بازی ProGrip", Price = 1250000, Imagename = "" },
        new() { ProductId = 7, Name = "Kingdom Tactics", Price = 299000, Imagename = "" },
        new() { ProductId = 8, Name = "Arctic Survival Co-op", Price = 259000, Imagename = "" },
    };

    private bool _isLoading = false;
    private string _searchTerm = "";
    private string _activeCategory = "همه";
    private readonly string[] _categories = { "همه", "اکشن", "ماجراجویی", "ورزشی", "لوازم جانبی" };

    private IEnumerable<ProductForIndex> _filteredProducts =>
        _mockProducts.Where(p => string.IsNullOrWhiteSpace(_searchTerm)
            || p.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

    private void OnCategoryChanged(IReadOnlyCollection<string> selected)
    {
        _activeCategory = selected.FirstOrDefault() ?? "همه";
    }

    private string GetImageUrl(ProductForIndex product) =>
        string.IsNullOrEmpty(product.Imagename) ? "" : $"/images/products/{product.Imagename}";

    private string GetTagColor(int productId) =>
        (productId % 3) switch { 0 => "gold", 1 => "teal", _ => "coral" };

    private string GetCategoryLabel(int productId) =>
        (productId % 4) switch
        {
            0 => "اکشن",
            1 => "مسابقه‌ای",
            2 => "لوازم جانبی",
            _ => "ورزشی"
        };

    private string FormatPrice(long price) => $"{price:N0}";

    private void AddToCart(ProductForIndex product)
    {
        // اتصال به سبد خرید بعداً اضافه می‌شود
    }
}
